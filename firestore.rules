rules_version = '2';
// OxGuess Firestore rules. Paste into Firebase console → Firestore Database → Rules → Publish.
// Players have no accounts yet, so the rules keep every write small and shaped: a herd summary can only
// ever go up by exactly one guess in one bin, and nothing else exists. Guesses and plays can be read for the
// stats page (oxguess.com/stats); they hold an anonymous device id and numbers, nothing about a person.
service cloud.firestore {
  match /databases/{database}/documents {

    // herd/{date}_{questionId}: { n: total guesses, b: { "0".."99": count }, k: the bin the last guess went in }.
    // Anyone can read. Each write must add exactly one guess, to bin k.
    match /herd/{herdId} {
      allow read: if true;
      allow create: if herdId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z0-9-]{1,24}$')
        && request.resource.data.keys().hasOnly(['n', 'b', 'k'])
        && isBin(request.resource.data.k)
        && request.resource.data.n == 1
        && request.resource.data.b is map
        && request.resource.data.b.keys().hasOnly([request.resource.data.k])
        && request.resource.data.b[request.resource.data.k] == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['n', 'b', 'k'])
        && isBin(request.resource.data.k)
        && request.resource.data.n == resource.data.n + 1
        && request.resource.data.b.diff(resource.data.b).affectedKeys().hasOnly([request.resource.data.k])
        && request.resource.data.b[request.resource.data.k] == resource.data.b.get(request.resource.data.k, 0) + 1;
    }

    // guesses/{auto}: one row per guess. Readable for the stats page. arm, lo and hi (the slider test: which
    // slider and its ends) are optional so older copies of the game still save.
    match /guesses/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['day', 'qid', 'pos', 'value', 'player', 'at', 'arm', 'lo', 'hi'])
        && request.resource.data.day is string && request.resource.data.day.size() == 10
        && request.resource.data.qid is string && request.resource.data.qid.size() <= 24
        && request.resource.data.pos is int && request.resource.data.pos >= 0 && request.resource.data.pos <= 1000
        && request.resource.data.value is number
        && (!('arm' in request.resource.data) || request.resource.data.arm in ['A', 'B'])
        && (!('lo' in request.resource.data) || request.resource.data.lo is number)
        && (!('hi' in request.resource.data) || request.resource.data.hi is number)
        && isPlayer(request.resource.data.player)
        && request.resource.data.at == request.time;
    }

    // plays/{date}_{player}: a finished round. Readable for the stats page.
    match /plays/{id} {
      allow read: if true;
      allow create, update: if id == request.resource.data.day + '_' + request.resource.data.player
        && request.resource.data.keys().hasOnly(['day', 'round', 'player', 'pts', 'total', 'at'])
        && request.resource.data.day is string && request.resource.data.day.size() == 10
        && request.resource.data.round is int
        && isPlayer(request.resource.data.player)
        && request.resource.data.pts is list && request.resource.data.pts.size() == 5
        && request.resource.data.total is int && request.resource.data.total >= 0 && request.resource.data.total <= 100
        && request.resource.data.at == request.time;
    }

    // players/{id}: one summary per player, rebuilt by their device after each round. Write-only for now.
    match /players/{id} {
      allow read: if false;
      allow create, update: if id == request.resource.data.player
        && isPlayer(request.resource.data.player)
        && request.resource.data.keys().hasOnly(['player', 'first', 'last', 'rounds', 'points', 'best', 'streak', 'bestStreak', 'updated'])
        && isDay(request.resource.data.first) && isDay(request.resource.data.last)
        && request.resource.data.rounds is int && request.resource.data.rounds >= 1 && request.resource.data.rounds <= 100000
        && request.resource.data.points is int && request.resource.data.points >= 0 && request.resource.data.points <= request.resource.data.rounds * 100
        && request.resource.data.best is int && request.resource.data.best >= 0 && request.resource.data.best <= 100
        && request.resource.data.streak is int && request.resource.data.streak >= 0 && request.resource.data.streak <= request.resource.data.rounds
        && request.resource.data.bestStreak is int && request.resource.data.bestStreak >= request.resource.data.streak && request.resource.data.bestStreak <= request.resource.data.rounds
        && request.resource.data.updated == request.time;
    }

    function isDay(d) {
      return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function isBin(k) {
      return k is string && k.matches('^[0-9]{1,2}$');
    }
    function isPlayer(p) {
      return p is string && p.size() <= 48 && p.matches('^p-[A-Za-z0-9-]+$');
    }
  }
}
